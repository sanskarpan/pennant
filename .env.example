# Feature flag service configuration
# Copy to .env and fill in values for local development

# Server
PENNANT_ADMIN_TOKEN=          # Legacy: leave empty for dev, set for token-based auth
PENNANT_JWT_SECRET=           # REQUIRED in production. Minimum 32 chars.
PENNANT_CORS_ORIGINS=         # Comma-separated allowed origins. Empty = allow all (dev only)

# Storage (pick one)
# SQLITE_PATH=/data/pennant.db           # Default if neither is set: in-memory
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=disable

# TLS (optional — use when running without a reverse proxy)
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
# TLS_AUTO_DOMAIN=flags.yourdomain.com    # Uses Let's Encrypt autocert
